# Copy to `.env` (compose reads it automatically from this directory) and fill in.
#
# NOTHING SECRET GOES HERE. This file is the boring, checked-in configuration: hostnames, identifiers, paths.
# Secrets (DATABASE_URL, FORGE_VAULT_KEY, the seed token) are fetched by env-source.sh and exported into the
# shell, so they never land on disk. Shell values win over this file — that is what makes the split work.
#
# ★ THE VALUES BELOW ARE THE BENCH'S, not a deployment's. This instance runs on a laptop today; the lines
# marked ⚠️ are the ones that change the day it gets a hostname.

# --- ⚠️ how this box is reached ---------------------------------------------------------------------------
# On the bench: one origin, plain HTTP, one port. The admin is served under /admin* (see caddy/Caddyfile.local).
# In a deployment: the real hostnames, FORGE_CADDYFILE unset (the production edge is the default), and the
# admin gets a subdomain of its own — an admin sharing an origin with the shop shares its cookies too.
FORGE_CADDYFILE=./caddy/Caddyfile.local
FORGE_HTTP_PORT=8080
FORGE_HTTPS_PORT=8444
FORGE_DOMAIN=localhost
FORGE_ADMIN_DOMAIN=localhost
# The address a BROWSER reaches this stack at. It is not decoration: the kernel's local media driver derives
# every product image URL from it, so a wrong value gives a catalogue of broken images and nothing in a log.
FORGE_PUBLIC_ORIGIN=http://localhost:8080

# --- who this instance is ---------------------------------------------------------------------------------
# The tenant + FIRST store created at bootstrap (`provision-ref`). The demo's OTHER stores are created by
# bin/seed.mjs, through the port, because a second store is data and not bootstrap.
FORGE_REF_TENANT=forgeco
FORGE_REF_STORE_HANDLE=outlet
FORGE_REF_STORE_NAME=Forge Outlet
FORGE_ADMIN_TENANT=forgeco

# The first operator, invited by the bootstrap one-shot. Without it nobody can enter the admin. With no SMTP
# configured the login code is written to the kernel's stdout — `docker compose logs kernel` is the inbox.
FORGE_ADMIN_SEED_EMAIL=voce@exemplo.com.br
FORGE_ADMIN_SEED_NAME=Você

# --- our own apps -----------------------------------------------------------------------------------------
# `demo-gate` is the only one, and it is here rather than on composition.json because an app of ONE box is
# MOUNTED, never composed into an image.
FORGE_EXTENSIONS_DIR=/app/extensions
FORGE_EXTENSIONS_HOST_DIR=./extensions

# --- the themes -------------------------------------------------------------------------------------------
# Where BOTH fronts look for a theme folder — a store's `theme_key` names one of them (./themes/outlet,
# ./themes/coffee-store). Mounted into the storefront AND the checkout: a themes mount on the vitrine alone
# gives a shop that changes clothes at the "Finalizar compra" button.
FORGE_THEMES_DIR=/app/themes-instance
FORGE_THEMES_HOST_DIR=./themes

# --- media ------------------------------------------------------------------------------------------------
# EMPTY on purpose FOR THE KERNEL. With no base URL its local driver derives one from FORGE_PUBLIC_ORIGIN,
# which is exactly what a bench wants. Point a bucket/CDN base here the day the demo needs one.
#
# ⚠️ THE FRONTS DO NOT SHARE THAT DEFAULT, and compose gives them one of their own (see DIFFERENCE 4 there).
# They join base+key server-side for the DERIVATIVE door (`/api/img`), which is how a composed banner is
# served — and with no base that door answers `404 media base not configured`, so every tile of a banner
# mosaic is a broken image while the product photos beside it are fine. Setting a value here overrides all
# three, which is what a real bucket wants.
FORGE_MEDIA_BASE_URL=

# --- the gate ---------------------------------------------------------------------------------------------
# The demo-gate app's own wiring, read when its block renders. Both optional.
# ⚠️ THE GATE'S SCREEN DOES NOT RENDER YET, and that is a property of the model rather than a missing value
# here: the front half of a gate resolves through a STATIC registry inside the storefront build, which ships
# empty in the reference front. The app installs and fills `storefront:gate` in the data; the interstitial
# arrives when this instance owns its vitrine build (slice C1). See README, "What the gate does and does not
# do yet".
FORGE_GATE_SITE_URL=https://forgecommerce.pro
FORGE_GATE_ADMIN_URL=

# --- optional -----------------------------------------------------------------------------------------------
# Shared between admin, storefront and kernel so a write busts the right cache entry. Any random string.
FORGE_REVALIDATE_SECRET=
# host → store override, only useful while cutting over. Normally empty: host → store is DATA (set the store's
# public URL in the admin and it routes, no restart).
FORGE_STORE_HOSTS=
# Set to 1 to enable /login/ops (paste a raw token) as a break-glass door into the admin.
FORGE_ADMIN_OPS_LOGIN=
FORGE_TLS_CERT_DIR=./caddy/certs
FORGE_CADDY_EXTRA_DIR=./caddy/extra
FORGE_ADMIN_I18N_HOST_DIR=./i18n

# --- the port on the internet -------------------------------------------------------------------------------
# WHO MAY REACH THE CONTROL FACE (/v1/control/*), as space-separated CIDRs. EMPTY IS THE ANSWER here: the
# Caddyfile's own default is loopback, i.e. nobody. (The bench edge does not route it at all.)
FORGE_CONTROL_ALLOW_CIDR=
FORGE_RATE_LIMIT_PER_CREDENTIAL=
FORGE_RATE_LIMIT_WINDOW_SECONDS=

# The admin gets its own origin on the bench (a path prefix does not work — caddy/Caddyfile.local
# carries the measurement). In a deployment the admin has FORGE_ADMIN_DOMAIN and this is inert.
FORGE_ADMIN_HTTP_PORT=8081

# ── THE COUNTER'S TOTEM (T2·S2) ──────────────────────────────────────────────────────────────────────────
# The sixth image of this instance: one Next app of ours serving the whole counter host. Build it with
# `bash bin/build-totem.sh <forge checkout>` before `docker compose up`.
#
# ★★ THE STORE TAKES TWO VARIABLES, AND THAT IS NOT REDUNDANCY. The public read face resolves a store by ID
# or by HOST; there is no `store.by_handle` (the only capability that returns a handle lives on the internal
# face, behind the admin service token, which the totem deliberately does not hold). So:
#   · FORGE_TOTEM_STORE_ID     — what the process actually sends to the port. Required.
#   · FORGE_TOTEM_STORE_HANDLE — what a HUMAN reads to know which shop that id is. Required, and the reason
#                                the id above is reviewable at all.
# The app refuses to boot if either is missing, or if the handle was pasted into the id slot.
FORGE_TOTEM_STORE_ID=
FORGE_TOTEM_STORE_HANDLE=balcao
# How long the screen waits before deciding the customer walked away: it clears the basket and returns to
# "Toque para começar". Seconds. Lower it to rehearse the reset; do not raise it much — the whole point is
# that one person's order never greets the next person.
FORGE_TOTEM_IDLE_SECONDS=90
# The bench port for the totem, published by compose.override.yml (site `:82` in caddy/Caddyfile.local),
# mirroring the admin's own port. Unused in a deployment, where the counter gets the hostname below.
FORGE_TOTEM_HTTP_PORT=8102
# The counter's public hostname in a DEPLOYMENT (caddy/Caddyfile). Leave empty on a bench.
FORGE_TOTEM_DOMAIN=
