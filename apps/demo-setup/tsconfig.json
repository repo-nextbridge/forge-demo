{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "manifest.ts",
    "icon.ts",
    "block/*.tsx",
    "global.d.ts",
    "*.test.ts",
    "*.test.tsx",
    "block/*.test.tsx"
  ],
  "exclude": ["node_modules"]
}
