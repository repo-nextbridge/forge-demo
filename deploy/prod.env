# THE PRODUCTION BOX — what differs from `deploy/box.env`, and nothing else.
#
# This is the one the weekly rebirth cron runs against (decision 5 of the INFRA-EXEMPLAR spec), and the one
# the public reaches. A pin arrives here only after the SAME lock has been proved on staging.

# ── where it is ─────────────────────────────────────────────────────────────────────────────────────────────
FORGE_DEPLOY_HOST=216.238.120.61
FORGE_DEPLOY_USER=root
FORGE_DEPLOY_DIR=/opt/forge-demo
FORGE_DEPLOY_KEY=~/.ssh/forge-demo-deploy

# ── the six faces ───────────────────────────────────────────────────────────────────────────────────────────
# These six ARE the ones `seed/box.json` declares (`domain`/`admin_domain`, lines 142-350). They are repeated
# here because a deployment's `.env` is what compose reads and nothing carries that file's values into one —
# see the note in `deploy/stag.env` for the gap this leaves and why it was not closed in this slice.
FORGE_DOMAIN=store.forgecommerce.pro
FORGE_OUTLET_DOMAIN=outlet.store.forgecommerce.pro
FORGE_CAFE_DOMAIN=cafe.forgecommerce.pro
FORGE_TOTEM_DOMAIN=totem.cafe.forgecommerce.pro
FORGE_ADMIN_DOMAIN=admin.store.forgecommerce.pro
FORGE_CAFE_ADMIN_DOMAIN=admin.cafe.forgecommerce.pro

FORGE_PUBLIC_ORIGIN=https://store.forgecommerce.pro

FORGE_GATE_SITE_URL=https://forgecommerce.pro

# ── media ───────────────────────────────────────────────────────────────────────────────────────────────────
FORGE_STORAGE_BUCKET=forge-demo-prod
