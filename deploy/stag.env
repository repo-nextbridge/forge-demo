# THE STAGING BOX — what differs from `deploy/box.env`, and nothing else.
#
# There is no cron here (decision 5 of the INFRA-EXEMPLAR spec): this box is reborn BY HAND, before a pin is
# rehearsed and after a round of testing. It is the box a pin is proved on before the same lock reaches prod.

# ── where it is ─────────────────────────────────────────────────────────────────────────────────────────────
# ⚠️ THE ADDRESS IS DATA AND IT LIVES HERE, not in `bin/deploy.sh`. An environment is a HOST plus six
# hostnames plus a bucket; a script that knew any of them would have to be edited to add a third box.
FORGE_DEPLOY_HOST=216.128.171.74
FORGE_DEPLOY_USER=root
FORGE_DEPLOY_DIR=/opt/forge-demo
FORGE_DEPLOY_KEY=~/.ssh/forge-demo-deploy

# ── the six faces ───────────────────────────────────────────────────────────────────────────────────────────
# ⚠️ WHY THEY ARE TYPED HERE AND NOT DERIVED FROM `seed/box.json`, WHICH IS WHERE A HOSTNAME BELONGS.
# That file declares ONE hostname per store and one per tenant, and it has no environment axis: it names the
# PRODUCTION six (`store.forgecommerce.pro` and its five siblings, seed/box.json:142-350). A staging box is
# the same topology at different addresses, and there is nowhere in that file to say so — which is why
# `bin/box-up.sh --promote` can point the bench at the production names and cannot point anything at these.
# ⇒ RECORDED AS A GAP rather than solved here: the fix is an environment axis in `seed/box.json`, and it
# touches the birth, the promotion and three guards. Until then these six are the second place a hostname is
# stated, and `bin/deploy.guard.mjs` holds them to the SHAPE of the six that file declares.
FORGE_DOMAIN=stg.store.forgecommerce.pro
FORGE_OUTLET_DOMAIN=stg.outlet.store.forgecommerce.pro
FORGE_CAFE_DOMAIN=stg.cafe.forgecommerce.pro
FORGE_TOTEM_DOMAIN=stg.totem.cafe.forgecommerce.pro
FORGE_ADMIN_DOMAIN=stg.admin.store.forgecommerce.pro
FORGE_CAFE_ADMIN_DOMAIN=stg.admin.cafe.forgecommerce.pro

# The address a BROWSER reaches this box at — the root shop's. The kernel derives media URLs from it when no
# media base is set, and the admin prints it on every screen that hands somebody an address to paste.
FORGE_PUBLIC_ORIGIN=https://stg.store.forgecommerce.pro

# Where the gate's "back to the site" link goes. The same for both boxes: it is the product's own site.
FORGE_GATE_SITE_URL=https://forgecommerce.pro

# ── media ───────────────────────────────────────────────────────────────────────────────────────────────────
# The bucket this environment owns. Inert until the driver exists in the pinned kernel — see deploy/box.env.
FORGE_STORAGE_BUCKET=forge-demo-stag
